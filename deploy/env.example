# Copy to /opt/LowcostSlamServer/.env to change a setting, then: sudo systemctl restart lowcost-slam-api
# Everything is optional, the defaults are in app/core/config.py.

# Where the API listens. 127.0.0.1: only this board. 0.0.0.0: the whole network (there is no login).
#API_HOST=127.0.0.1
#API_PORT=8000

# Sensors
#IMU_I2C_HZ=100          # 1, 10, 25, 50, 100, 200 or 400
#IMU_RANGE_G=2           # 2, 4, 8 or 16: 1, 2, 4 or 12 mg per count
#GNSS_RATE_HZ=1
#IMU_I2C_BUS=/dev/i2c-header-27-28
#GNSS_I2C_BUS=/dev/i2c-header-3-5

# Storage: a USB stick is preferred when one is mounted
#LOCAL_DATA_PATH=/home/radxa/measurements

# Bluetooth (the phone app). Everything is optional.
#DEVICE_NAME=SLAM-840         # at most 8 characters: it has to fit the advertisement together with the UUID
#BLE_OPEN_PAIRING=1           # accept every phone and pairing request without a PIN
#STATUS_POLL_INTERVAL=5
#GATT_CHUNK_SIZE=100
#POSITION_SIMULATOR=0         # development only: a fake position when there is no GNSS fix
