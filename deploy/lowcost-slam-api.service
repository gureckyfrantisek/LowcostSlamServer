[Unit]
Description=Lowcost SLAM server (FastAPI)
Documentation=file:///opt/LowcostSlamServer/README.md
# The sensors sit on the I2C buses of the board and the camera on USB, none of them needs the network.
After=local-fs.target
# Never give up restarting: a server that is down in the field is worth nothing.
StartLimitIntervalSec=0

[Service]
Type=simple
# Root for the USB access of the camera SDK. The sensors alone only need the gpio and i2c groups.
User=root
WorkingDirectory=/opt/LowcostSlamServer
# Defaults first, /opt/LowcostSlamServer/.env overrides them (see deploy/env.example)
Environment=PYTHONUNBUFFERED=1
Environment=API_HOST=127.0.0.1
Environment=API_PORT=8000
EnvironmentFile=-/opt/LowcostSlamServer/.env
ExecStart=/opt/LowcostSlamServer/.venv/bin/uvicorn app.main:app --host ${API_HOST} --port ${API_PORT} --no-access-log
Restart=always
RestartSec=3
# A recording is closed cleanly on a stop: uvicorn gets time to flush the files
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
